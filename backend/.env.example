# ─────────────────────────────────────────────────────────────────────────────
# Chakam backend environment template. Copy to `.env` and fill in real values.
#   cp .env.example .env
#
# The SAME file works for both backends (they share these vars); the heavy
# backend (main.py) uses everything except HEAVY_BACKEND_URL, and the light
# backend (main-light.py) uses everything except the CLOUDINARY_* vars.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (database name: smartclassDB). REQUIRED by both.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartclassDB?retryWrites=true&w=majority

# Cloudinary — used by the HEAVY backend (main.py) to store annotated images.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Email (capacity alerts) ──────────────────────────────────────────────────
# Email is sent EXCLUSIVELY through the external HTTP mailer service (the
# `mailer/` Next.js app). The backend does NOT talk SMTP directly anymore —
# there is no SMTP_EMAIL / SMTP_PASSWORD path. All mail goes through MAILER_URL.
ALERT_EMAIL=alerts@example.com                      # who receives capacity alerts
MAILER_URL=https://<your-mailer>.vercel.app/api/send # the mailer /api/send endpoint
MAILER_SECRET=<shared-secret>                        # must match MAILER_SECRET in the mailer app

# ── Light backend only (main-light.py) ───────────────────────────────────────
# Where the light backend forwards the heavy image/face endpoints. Point this at
# your heavy backend (the AWS box). NOTE: Azure is retired — do not use the old
# *.cloudapp.azure.com URL. Leave unset/omit when running the heavy backend.
# HEAVY_BACKEND_URL=https://chakam-api.duckdns.org

# ── Authentication ────────────────────────────────────────────────────────────
# Both backends register /auth and /admin routes and share this config. REQUIRED:
# JWT_SECRET signs every issued token; the app refuses to start without a long,
# random value (at least 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-a-long-random-value>

TOKEN_TTL_HOURS=24
ADMIN_TOKEN_TTL_HOURS=8

# Comma-separated bootstrap administrator addresses. Any address listed here is
# granted role "admin" on every login regardless of domain pattern — replace the
# placeholder before deploying.
ADMIN_EMAILS=admin@unilag.edu.ng

# Shared secret for the camera image endpoint (X-Device-Secret header).
# Declared for future use — NOT enforced. The device-secret check was rolled
# back pending a decision with the hardware team; the endpoint still only
# checks deviceId, exactly as before auth work started.
DEVICE_SECRET=<generate-a-shared-secret>

STUDENT_EMAIL_DOMAIN=live.unilag.edu.ng
STAFF_EMAIL_DOMAIN=unilag.edu.ng
MATRIC_DIGITS=9
LOGIN_CODE_TTL_MINUTES=10
