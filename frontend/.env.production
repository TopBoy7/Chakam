# Production build (used by `vite build`). The frontend points at the always-on
# Render light backend, which forwards heavy image/face endpoints to Azure.
# If you set these in the Vercel dashboard instead, the dashboard values win.
VITE_API_BASE_URL=https://chakam-backend.onrender.com
VITE_WS_URL=wss://chakam-backend.onrender.com
VITE_ADMIN_PASSWORD=password
