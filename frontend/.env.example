# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment template. Copy to `.env` for local dev, or set these
# in the Vercel project dashboard for production.
#
# The frontend talks to ONE backend base URL. In production that is the always-on
# Render (light) backend; Render transparently forwards the heavy image/face
# endpoints to Azure, so the frontend needs no Azure URL of its own.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP API base (no trailing slash).
#   local:      http://localhost:8000
#   production: https://chakam-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# WebSocket base (no trailing slash, no /ws suffix — the hook appends it).
# Must use ws:// for http and wss:// for https.
#   local:      ws://localhost:8000
#   production: wss://chakam-backend.onrender.com
VITE_WS_URL=ws://localhost:8000

# Password for the dashboard admin gate (client-side only — not real auth).
VITE_ADMIN_PASSWORD=password
